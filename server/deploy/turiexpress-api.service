[Unit]
Description=Turiexpress reservation API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=emma560
Group=emma560
WorkingDirectory=/home/emma560/turiexpress/server
EnvironmentFile=/home/emma560/turiexpress/server/.env
ExecStart=/usr/bin/node /home/emma560/turiexpress/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/emma560/turiexpress

[Install]
WantedBy=multi-user.target
