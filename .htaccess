DirectoryIndex index.html

RewriteEngine On

# Mantiene una sola URL pública por página: sin .html.
# Excluye los archivos de verificación de Google (googleXXXXXXXX.html): deben
# servirse tal cual, en esa URL exacta y sin redirección, o Search Console no los valida.
RewriteCond %{REQUEST_URI} !^/google[a-f0-9]+\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{REQUEST_URI} !^/google[a-f0-9]+\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[?\s] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Sirve internamente los archivos HTML cuando la URL se solicita sin extensión.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
